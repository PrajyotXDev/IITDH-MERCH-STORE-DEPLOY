PORT=3000
# Persistent writable storage directory (Render disk: /var/data)
DATA_DIR=./data

# Base64-encoded Google service-account JSON and spreadsheet location
GOOGLE_SERVICE_ACCOUNT_JSON_B64=replace_with_base64_encoded_service_account_json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_TAB=Orders

# SMTP settings (use an app password; never a normal account password)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_app_password
MAIL_FROM=your_email@example.com

# Long random token for staff scanner/admin endpoints
ADMIN_TOKEN=replace_with_a_long_random_token