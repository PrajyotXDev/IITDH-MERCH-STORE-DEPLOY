PORT=3000

# Supabase (server-only). Set the SECRET key in Vercel's Environment Variables dashboard; never commit it,
# never prefix it with NEXT_PUBLIC_/VITE_, and never put it in frontend code.
SUPABASE_URL=https://kpqtgiywngjkspkuokgk.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Staff access: comma-separated "name:sha256-of-token". Generate with: node scripts/make-staff-token.js "Alice"
# Give each staff member their own token privately; only the hashes go in this variable.
STAFF_TOKEN_HASHES=Alice:replace_with_64_hex_chars

# Razorpay (use TEST keys first: Dashboard -> Account & Settings -> API Keys, with the dashboard in Test Mode).
# KEY_ID is public by design (it is sent to the browser). KEY_SECRET and WEBHOOK_SECRET are server-only: set them ONLY in Vercel.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Webhook: Razorpay Dashboard -> Account & Settings -> Webhooks. URL: https://YOUR-DOMAIN/api/razorpay/webhook
# Events: payment.captured, order.paid. Set a secret there and put the same value here.
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Base64-encoded Google service-account JSON and spreadsheet location (share the sheet with the service account's email as Editor)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=replace_with_base64_encoded_service_account_json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_TAB=Orders

# SMTP settings (use an app password; never a normal account password)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_app_password
MAIL_FROM=your_email@example.com
